# Set the verified production origin before building for deployment.
# Leaving this unset keeps the preview unindexed and the sitemap empty.
NEXT_PUBLIC_SITE_URL=

# Optional server-only delivery integration. Leave empty for browser-only enquiry drafts.
# The receiver should accept JSON POSTs and return 2xx only after accepting the enquiry.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
